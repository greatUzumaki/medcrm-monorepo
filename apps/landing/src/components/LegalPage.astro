---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { localePath, t, type Locale } from '../i18n';
import { site } from '../site';
import { docs, type LegalDoc } from '../legal';

interface Props {
  lang: Locale;
  doc: LegalDoc;
}
const { lang, doc } = Astro.props;
const d = t(lang);
const legal = docs[doc];
const page = `${doc}/`;
const title = d.legal[doc];
---

<Base lang={lang} title={`${title} — ${site.brand}`} description={`${title} ${site.brand}`} page={page} noindex>
  <Header lang={lang} page={page} />
  <main id="main" class="wrap doc">
    <h1>{title}</h1>
    {lang !== 'ru' && <p class="note">{d.legal.ruOnly}</p>}
    <article lang="ru">
      {lang !== 'ru' && <h2 class="ru-title">{legal.title}</h2>}
      <p class="meta">{d.legal.version} {legal.version}</p>
      {
        legal.sections.map((s) => (
          <section>
            <h3>{s.h}</h3>
            {s.p.map((p) => <p>{p}</p>)}
          </section>
        ))
      }
    </article>
    <a class="btn btn-ghost" href={localePath(lang)}>{d.legal.back}</a>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .doc {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 46rem;
    padding-block: clamp(4rem, 10vw, 8rem);
  }
  h1 {
    font-size: var(--step-3);
  }
  article {
    display: grid;
    gap: 1.75rem;
  }
  section {
    display: grid;
    gap: 0.6rem;
  }
  .ru-title {
    font-size: var(--step-1);
  }
  h3 {
    font-size: var(--step-0);
  }
  p {
    color: var(--ink-2);
    line-height: 1.65;
  }
  .note {
    padding: 0.9rem 1.1rem;
    border-radius: var(--r-sm);
    background: var(--surface);
  }
  .meta {
    font-size: var(--step--1);
  }
</style>
