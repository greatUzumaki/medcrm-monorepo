---
import { site } from '../site';
---

<span class="logo">
  <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#4f7bff" />
        <stop offset=".5" stop-color="#7c6cff" />
        <stop offset="1" stop-color="#e15fc6" />
      </linearGradient>
    </defs>
    <path
      d="M9 3c0 7 14 7 14 13S9 22 9 29M23 3c0 7-14 7-14 13s14 6 14 13"
      fill="none"
      stroke="url(#logo-g)"
      stroke-width="3"
      stroke-linecap="round"></path>
  </svg>
  <span>{site.brand}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
</style>
