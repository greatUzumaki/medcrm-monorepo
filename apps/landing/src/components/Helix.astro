---
// Particle DNA helix. Decorative: starts after load/idle so it never competes with LCP.
---

<div class="helix" aria-hidden="true">
  <div class="glow"></div>
  <canvas data-helix></canvas>
</div>

<script>
  type Particle = {
    t: number; // position along the helix 0..1
    kind: 0 | 1 | 2; // strand A, strand B, rung
    u: number; // rung interpolation 0..1
    r: number; // radial offset (cloud thickness)
    ang: number; // offset angle around strand
    seed: number;
    size: number;
    sx: number; // scatter start (screen, 0..1)
    sy: number;
    ox: number; // pointer displacement
    oy: number;
  };

  const canvas = document.querySelector<HTMLCanvasElement>('[data-helix]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const small = matchMedia('(max-width: 45rem)').matches;
    const N = small ? 900 : 2200;
    const TURNS = 2.4;
    const TILT = -0.5;
    const BUCKETS = 24;
    const stops = [
      [79, 123, 255],
      [124, 108, 255],
      [225, 95, 198],
    ];

    const lerp = (a: number, b: number, k: number) => a + (b - a) * k;
    const ease = (k: number) => 1 - Math.pow(1 - Math.min(1, Math.max(0, k)), 3);

    const sprites = Array.from({ length: BUCKETS }, (_, i) => {
      const k = i / (BUCKETS - 1);
      const [a, b] = k < 0.5 ? [stops[0]!, stops[1]!] : [stops[1]!, stops[2]!];
      const kk = k < 0.5 ? k * 2 : (k - 0.5) * 2;
      const c = a.map((v, j) => Math.round(lerp(v, b[j]!, kk))).join(',');
      const s = document.createElement('canvas');
      s.width = s.height = 32;
      const g = s.getContext('2d')!;
      const grad = g.createRadialGradient(16, 16, 0, 16, 16, 16);
      grad.addColorStop(0, `rgba(${c},1)`);
      grad.addColorStop(0.35, `rgba(${c},0.85)`);
      grad.addColorStop(1, `rgba(${c},0)`);
      g.fillStyle = grad;
      g.fillRect(0, 0, 32, 32);
      return s;
    });

    const rand = (a = 0, b = 1) => a + Math.random() * (b - a);
    const particles: Particle[] = Array.from({ length: N }, () => {
      const roll = Math.random();
      const kind: Particle['kind'] = roll < 0.4 ? 0 : roll < 0.8 ? 1 : 2;
      const spray = Math.random() < 0.08; // loose particles give the liquid, splashed look
      let t = Math.random();
      if (kind === 2) t = Math.round(t * TURNS * 7) / (TURNS * 7) + rand(-0.003, 0.003); // rungs at fixed steps
      return {
        t,
        kind,
        u: Math.random(),
        r: spray ? rand(0.15, 0.6) : Math.abs(rand(-1, 1) * rand(0, 1)) * 0.12,
        ang: rand(0, Math.PI * 2),
        seed: rand(0, 1000),
        size: spray ? rand(0.6, 1.4) : rand(1, 2.6),
        sx: rand(-0.2, 1.2),
        sy: rand(-0.2, 1.2),
        ox: 0,
        oy: 0,
      };
    });

    let W = 0;
    let H = 0;
    let dpr = 1;
    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
    };
    resize();
    new ResizeObserver(resize).observe(canvas);

    // Listen on the document: the hero copy sits above the canvas, so canvas-level events
    // never fire beside the text. Distance to particles decides whether anything moves.
    const pointer = { x: -1e4, y: -1e4 };
    const away = () => (pointer.x = pointer.y = -1e4);
    document.addEventListener('pointermove', (e) => {
      const b = canvas.getBoundingClientRect();
      pointer.x = e.clientX - b.left;
      pointer.y = e.clientY - b.top;
    }, { passive: true });
    document.addEventListener('pointerout', (e) => !e.relatedTarget && away()); // left the window
    document.addEventListener('pointerup', (e) => e.pointerType === 'touch' && away());
    document.addEventListener('pointercancel', away);

    const darkMq = matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => {
      const th = document.documentElement.dataset['theme'];
      return th ? th === 'dark' : darkMq.matches;
    };

    let start = 0;
    const draw = (now: number) => {
      const time = now / 1000;
      const elapsed = now - start;
      const R = Math.min(W, H) * (small ? 0.22 : 0.19);
      const L = Math.hypot(W, H) * 0.95;
      const cx = W * 0.5;
      const cy = H * 0.5;
      const cos = Math.cos(TILT);
      const sin = Math.sin(TILT);
      const spin = time * 0.35;
      const f = 900;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      // Additive blending makes particles glow on the dark theme; plain alpha reads better on light.
      ctx.globalCompositeOperation = isDark() ? 'lighter' : 'source-over';

      for (const p of particles) {
        const a = p.t * TURNS * Math.PI * 2 + spin;
        const y = (p.t - 0.5) * L;
        let x: number;
        let z: number;
        if (p.kind === 2) {
          x = lerp(Math.cos(a), Math.cos(a + Math.PI), p.u) * R;
          z = lerp(Math.sin(a), Math.sin(a + Math.PI), p.u) * R;
        } else {
          const aa = p.kind === 0 ? a : a + Math.PI;
          x = Math.cos(aa) * R;
          z = Math.sin(aa) * R;
        }
        // cloud thickness + slow breathing
        const wob = Math.sin(time * 0.8 + p.seed) * 0.25 + 1;
        x += Math.cos(p.ang + time * 0.3) * p.r * R * wob;
        z += Math.sin(p.ang + time * 0.3) * p.r * R * wob;
        const yy = y + Math.sin(time * 0.6 + p.seed) * R * 0.04;

        const scale = f / (f + z);
        let px = cx + (x * cos - yy * sin) * scale;
        let py = cy + (x * sin + yy * cos) * scale;

        // intro: particles converge from a scattered cloud, staggered along the strand
        const k = reduce ? 1 : ease((elapsed - p.t * 700) / 1700);
        if (k < 1) {
          px = lerp(p.sx * W, px, k);
          py = lerp(p.sy * H, py, k);
        }

        // pointer: particles part around the cursor, then spring back
        const dx = px - pointer.x;
        const dy = py - pointer.y;
        const d2 = dx * dx + dy * dy;
        const reach = 130;
        let tx = 0;
        let ty = 0;
        if (d2 < reach * reach) {
          const d = Math.sqrt(d2) || 1;
          const push = Math.pow(1 - d / reach, 2) * 46;
          tx = (dx / d) * push;
          ty = (dy / d) * push;
        }
        p.ox += (tx - p.ox) * 0.12;
        p.oy += (ty - p.oy) * 0.12;

        const depth = (z / R + 1) / 2; // 0 near .. 1 far
        const size = p.size * scale * (1.6 - depth * 0.6);
        const bucket = Math.min(BUCKETS - 1, Math.max(0, Math.floor((p.t + Math.sin(a) * 0.08) * BUCKETS)));
        ctx.globalAlpha = (0.95 - depth * 0.6) * k;
        ctx.drawImage(sprites[bucket]!, px + p.ox - size * 2, py + p.oy - size * 2, size * 4, size * 4);
      }
      ctx.globalAlpha = 1;
    };

    let raf = 0;
    let visible = true;
    const loop = (now: number) => {
      draw(now);
      raf = requestAnimationFrame(loop);
    };
    const play = () => {
      if (!raf && visible && !document.hidden) raf = requestAnimationFrame(loop);
    };
    const pause = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    const boot = () => {
      start = performance.now();
      canvas.classList.add('on');
      if (reduce) {
        draw(start);
        // Static frame: repaint when the theme changes.
        new MutationObserver(() => draw(performance.now())).observe(document.documentElement, { attributeFilter: ['data-theme'] });
        darkMq.addEventListener('change', () => draw(performance.now()));
        return;
      }
      new IntersectionObserver(([e]) => {
        visible = !!e?.isIntersecting;
        visible ? play() : pause();
      }).observe(canvas);
      document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
      play();
    };

    const idle = (cb: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 1200 }) : setTimeout(cb, 200);
    document.readyState === 'complete' ? idle(boot) : addEventListener('load', () => idle(boot), { once: true });
  }
</script>

<style>
  .helix {
    position: relative;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .glow {
    position: absolute;
    inset: 15% 20%;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, color-mix(in oklab, var(--iris-2) 35%, transparent), transparent),
      radial-gradient(closest-side at 70% 30%, color-mix(in oklab, var(--iris-3) 30%, transparent), transparent),
      radial-gradient(closest-side at 30% 75%, color-mix(in oklab, var(--iris-1) 30%, transparent), transparent);
    filter: blur(40px);
    transform: rotate(-28deg) scaleY(1.6);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  canvas:global(.on) {
    opacity: 1;
  }
</style>
