---
import Logo from './Logo.astro';
import { localePath, type Locale, t } from '../i18n';
import { site } from '../site';
import { operator } from '../legal';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const d = t(lang);
const home = localePath(lang);
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <Logo />
        <p>{d.footer.tagline}</p>
      </div>

      <div class="col">
        <h2>{d.footer.contacts}</h2>
        <address>
          <a href={site.phoneHref}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.telegram} rel="noopener" target="_blank">Telegram {site.telegramLabel}</a>
          <span>{d.footer.address}</span>
          <span>{d.footer.hours}</span>
        </address>
      </div>

      <nav class="col" aria-label={d.footer.navigation}>
        <h2>{d.footer.navigation}</h2>
        <a href={`${home}#product`}>{d.nav.product}</a>
        <a href={`${home}#features`}>{d.nav.features}</a>
        <a href={`${home}#ai`}>{d.nav.ai}</a>
        <a href={`${home}#security`}>{d.nav.security}</a>
        <a href={`${home}#contact`}>{d.nav.cta}</a>
      </nav>
    </div>

    <div class="bottom">
      <span>© {year} {site.brand}. {d.footer.rights}</span>
      <span>{d.footer.operator}: {operator.name}, ИНН {operator.inn}, ОГРН {operator.ogrn}</span>
      <a href={localePath(lang, 'privacy/')}>{d.footer.privacy}</a>
      <a href={localePath(lang, 'consent/')}>{d.footer.consent}</a>
    </div>
  </div>
</footer>

<style>
  .ftr {
    padding-block: clamp(3.5rem, 8vw, 6rem) 2rem;
    border-top: 1px solid var(--line);
  }

  .top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 2.5rem;
  }

  .brand {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .brand p {
    max-width: 22rem;
    color: var(--ink-2);
  }

  .col,
  address {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    font-style: normal;
  }

  h2 {
    margin-bottom: 0.4rem;
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-2);
  }

  .col a,
  .bottom a {
    text-decoration: none;
  }

  .col a:hover,
  .bottom a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  address span {
    color: var(--ink-2);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  @media (max-width: 48rem) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 30rem) {
    .top {
      grid-template-columns: 1fr;
    }
  }
</style>
