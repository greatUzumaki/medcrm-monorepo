---
import type { Dict } from '../../i18n';

interface Props {
  d: Dict;
}
const { d } = Astro.props;

const icons = [
  'M12 21s-7-5.5-7-11a7 7 0 0114 0c0 5.5-7 11-7 11zM12 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z',
  'M6 11V8a6 6 0 0112 0v3M5 11h14v10H5zM12 15v2',
  'M5 4h14v16H5zM9 8h6M9 12h6M9 16h3',
  'M16 11a4 4 0 10-8 0M4 21a8 8 0 0116 0M12 7a3 3 0 100-6',
  'M7 3h10v18H7zM11 18h2M10 8l1.5 1.5L14 7',
  'M3 4h7v7H3zM14 4h7v7h-7zM3 15h7v7H3zM14 15h7v7h-7z',
];
---

<section id="security" class="section security">
  <div class="wrap">
    <div class="head">
      <h2>{d.security.title}</h2>
      <p class="lead">{d.security.lead}</p>
    </div>
    <ul>
      {
        d.security.items.map((s, i) => (
          <li>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[i]} />
            </svg>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .security {
    position: relative;
    margin-inline: clamp(0.5rem, 1.5vw, 1.25rem);
    border-radius: clamp(1.5rem, 4vw, 3rem);
    background: var(--deep);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
  }

  .security::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 60rem;
    height: 60rem;
    right: -25rem;
    top: -30rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--iris-2) 45%, transparent), transparent 70%);
    filter: blur(20px);
  }

  .head {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .lead {
    color: rgb(255 255 255 / 0.72);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: rgb(255 255 255 / 0.1);
  }

  li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--deep);
  }

  svg {
    margin-bottom: 1rem;
    color: #a99dff;
  }

  li p {
    color: rgb(255 255 255 / 0.68);
  }

  @media (max-width: 56rem) {
    .head {
      grid-template-columns: 1fr;
    }
    ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 36rem) {
    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
