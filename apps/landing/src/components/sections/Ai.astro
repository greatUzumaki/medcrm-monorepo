---
import type { Dict } from '../../i18n';

interface Props {
  d: Dict;
}
const { d } = Astro.props;
// Which transcript lines each draft field was built from (same structure in every locale).
const sources = [[1, 3], [3], []];
---

<section id="ai" class="section ai">
  <div class="wrap">
    <div class="head">
      <h2>{d.ai.title}</h2>
      <p class="lead">{d.ai.lead}</p>
    </div>

    <div class="demo" data-reveal>
      <div class="panel transcript">
        <span class="label">
          <span class="rec"></span>
          {d.ai.transcriptLabel}
        </span>
        <ol>
          {
            d.ai.transcript.map((line, i) => (
              <li data-line={i} class:list={[i % 2 ? 'patient' : 'doctor']} style={`--i:${i}`}>
                <span class="who">{line.who}</span>
                <span class="text">{line.text}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="flow" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>

      <div class="panel draft">
        <div class="draft-head">
          <span class="label">{d.ai.draftLabel}</span>
          <span class="badge">{d.ai.badge}</span>
        </div>
        <dl>
          {
            d.ai.draft.map((f, i) => (
              <div class="field" data-src={sources[i]?.length ? sources[i].join(",") : undefined} style={`--i:${i}`}>
                <dt>{f.label}</dt>
                <dd class:list={[{ pending: !sources[i]?.length }]}>{f.text}</dd>
              </div>
            ))
          }
        </dl>
        <div class="draft-actions" aria-hidden="true">
          <span class="btn btn-primary fake">{d.ai.accept}</span>
          <span class="btn btn-ghost fake">{d.ai.edit}</span>
        </div>
      </div>
    </div>

    <ul class="points">
      {
        d.ai.points.map((p) => (
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M5 12l4 4L19 6" />
            </svg>
            {p}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const demo = document.querySelector<HTMLElement>('.ai [data-reveal]');
  if (demo) {
    demo.dataset['armed'] = '';
    new IntersectionObserver(
      ([e], io) => {
        if (e?.isIntersecting) {
          demo.classList.add('in');
          io.disconnect();
        }
      },
      { threshold: 0.35 },
    ).observe(demo);

    // Pointer-only enhancement: highlight the transcript lines a draft field was built from (sources are also stated in the copy).
    const lines = demo.querySelectorAll<HTMLElement>('[data-line]');
    demo.querySelectorAll<HTMLElement>('[data-src]').forEach((field) => {
      const ids = (field.dataset['src'] ?? '').split(',').filter(Boolean);
      const set = (on: boolean) => lines.forEach((l) => l.classList.toggle('hl', on && ids.includes(l.dataset['line'] ?? '')));
      field.addEventListener('pointerenter', () => set(true));
      field.addEventListener('pointerleave', () => set(false));
    });
  }
</script>

<style>
  .head {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .demo {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 1rem;
  }

  .panel {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-2);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .rec {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--danger);
    animation: rec 1.6s ease-in-out infinite;
  }

  @keyframes rec {
    50% {
      opacity: 0.25;
    }
  }

  ol {
    display: grid;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  li[data-line] {
    display: grid;
    gap: 0.15rem;
    max-width: 88%;
    padding: 0.75rem 1rem;
    border-radius: 1.1rem;
    background: var(--paper);
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }

  li.patient {
    justify-self: end;
    border-bottom-right-radius: 0.35rem;
  }

  li.doctor {
    border-bottom-left-radius: 0.35rem;
  }

  li.hl {
    background: color-mix(in oklab, var(--iris-2) 14%, var(--surface));
    box-shadow: 0 0 0 1.5px var(--iris-2);
  }

  .who {
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .text {
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .flow {
    display: grid;
    align-content: center;
    gap: 0.5rem;
  }

  .flow span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--iris-2);
    opacity: 0.25;
  }

  /* Gradient border: white padding-box over iris border-box. */
  .draft {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.25rem;
    border: 1.5px solid transparent;
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      var(--iris) border-box;
  }

  .draft-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .badge {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--iris-fill);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
  }

  dl {
    display: grid;
    align-content: start;
    gap: 1rem;
    margin: 0;
  }

  .field {
    padding: 0.75rem 0.875rem;
    margin-inline: -0.875rem;
    border-radius: var(--r-sm);
    transition: background-color 0.3s;
  }

  .field[data-src]:hover {
    background: var(--paper);
  }

  dt {
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 0.2rem;
  }

  dd {
    margin: 0;
  }

  dd.pending {
    color: var(--ink-2);
    font-style: italic;
  }

  .draft-actions {
    display: flex;
    gap: 0.5rem;
  }

  .fake {
    min-height: 2.5rem;
    padding: 0 1.1rem;
    font-size: 0.875rem;
    cursor: default;
  }

  .points {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }

  .points li {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }

  .points svg {
    color: var(--iris-2);
    flex: none;
  }

  /* Choreography: conversation appears, dots pulse, then the draft writes itself. */
  [data-armed] li[data-line] {
    opacity: 0;
    transform: translateY(10px);
  }
  [data-armed] .field dd {
    clip-path: inset(0 100% 0 0);
  }
  [data-armed] .field dt,
  [data-armed] .badge {
    opacity: 0;
  }

  .in li[data-line] {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out),
      background-color 0.3s,
      box-shadow 0.3s;
    transition-delay: calc(var(--i) * 0.45s), calc(var(--i) * 0.45s), 0s, 0s;
  }

  .in .flow span {
    animation: pulse 1.2s ease-in-out infinite;
  }
  .in .flow span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .in .flow span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes pulse {
    50% {
      opacity: 1;
      transform: scale(1.3);
    }
  }

  .in .field dt {
    opacity: 1;
    transition: opacity 0.4s;
    transition-delay: calc(1.9s + var(--i) * 0.5s);
  }

  .in .field dd {
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.9s steps(28, end);
    transition-delay: calc(2s + var(--i) * 0.5s);
  }

  .in .badge {
    opacity: 1;
    transition: opacity 0.5s 1.8s;
  }

  @media (max-width: 56rem) {
    .head {
      grid-template-columns: 1fr;
    }
    .demo {
      grid-template-columns: 1fr;
    }
    .flow {
      grid-auto-flow: column;
      justify-content: center;
    }
  }
</style>
