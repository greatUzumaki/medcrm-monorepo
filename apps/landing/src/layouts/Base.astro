---
import '../styles/global.css';
import cyrillic from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import cyrillicExt from '@fontsource-variable/onest/files/onest-cyrillic-ext-wght-normal.woff2?url';
import latin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import latinExt from '@fontsource-variable/onest/files/onest-latin-ext-wght-normal.woff2?url';
import { htmlLang, localePath, locales, ogLocale, t, type Locale } from '../i18n';
import { site as siteData } from '../site';
const brand = siteData.brand;

interface Props {
  lang: Locale;
  title: string;
  description: string;
  page?: string; // '' for home, 'privacy/' etc.
  detectLanguage?: boolean;
  jsonLd?: object;
  noindex?: boolean; // legal/404 pages are not search landing pages
}

const { lang, title, description, page = '', detectLanguage = false, jsonLd, noindex = false } = Astro.props;
// Ownership tokens from Yandex Webmaster / Google Search Console (optional, set at build time).
const yandexVerification = import.meta.env.PUBLIC_YANDEX_VERIFICATION as string | undefined;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_VERIFICATION as string | undefined;
const site = Astro.site ?? new URL('https://openmedai.ru');
const canonical = new URL(localePath(lang, page), site).href;
const ogImage = new URL(`/og/${lang}.png`, site).href; // rendered by `pnpm og`
// Only preload the subset the first paint needs; zh text uses system CJK fonts.
const preload = lang === 'ru' ? [cyrillic, latin] : lang === 'zh' ? [] : [latin];
// Own @font-face instead of fontsource's CSS: fontsource hardcodes font-display: swap, which re-flows
// text when Onest arrives. `optional` + preload: Onest if it lands within ~100 ms (almost always),
// otherwise the metric-matched 'Onest Fallback' for this view and Onest from cache on the next one.
const face = (src: string, range: string) =>
  `@font-face{font-family:'Onest Variable';font-style:normal;font-display:optional;font-weight:100 900;src:url(${src}) format('woff2-variations');unicode-range:${range}}`;
const fontFaces = [
  face(cyrillicExt, 'U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F'),
  face(cyrillic, 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116'),
  face(latinExt, 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF'),
  face(latin, 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD'),
].join('');
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {!noindex && locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localePath(l, page), site).href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(localePath('ru', page), site).href} />}
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <meta name="theme-color" content="#edeff3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0e1c" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply a saved theme before first paint (no flash). No saved choice → CSS follows the system.
      try {
        var th = localStorage.getItem('theme');
        if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th;
      } catch (e) {}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={fontFaces} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {!noindex && locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {
      detectLanguage && (
        <script is:inline>
          // Root (ru) page only: send first-time visitors to their browser language; a saved choice wins.
          (function () {
            try {
              if (/bot|crawl|spider|lighthouse|pagespeed/i.test(navigator.userAgent)) return;
              var sup = ['ru', 'en', 'zh', 'es'];
              var saved = localStorage.getItem('lang');
              var pick = sup.indexOf(saved) > -1 ? saved : null;
              if (!pick) {
                var langs = navigator.languages || [navigator.language || ''];
                for (var i = 0; i < langs.length && !pick; i++) {
                  var p = String(langs[i]).slice(0, 2).toLowerCase();
                  if (sup.indexOf(p) > -1) pick = p;
                }
                pick = pick || 'en';
              }
              if (pick !== 'ru') location.replace('/' + pick + '/' + location.hash);
            } catch (e) {}
          })();
        </script>
      )
    }
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t(lang).skip}</a>
    <slot />
  </body>
</html>
